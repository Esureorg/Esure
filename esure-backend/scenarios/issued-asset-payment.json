{
  "schemaVersion": 1,
  "id": "issued-asset-payment",
  "version": 1,
  "name": "Issued asset payment",
  "description": "Issue TESTUSD and send it to a recipient through a trustline.",
  "network": "testnet",
  "accounts": [
    { "id": "issuer", "generate": true, "fund": true },
    { "id": "recipient", "generate": true, "fund": true }
  ],
  "assets": [
    { "id": "xlm", "type": "native" },
    { "id": "test-usd", "type": "issued", "code": "TESTUSD", "issuer": "issuer" }
  ],
  "steps": [
    { "id": "create-trustline", "type": "changeTrust", "account": "recipient", "asset": "test-usd" },
    { "id": "send-testusd", "type": "payment", "from": "issuer", "to": "recipient", "asset": "test-usd", "amount": "100" }
  ],
  "assertions": [
    { "type": "balanceEquals", "account": "recipient", "asset": "test-usd", "amount": "100" }
  ]
}
